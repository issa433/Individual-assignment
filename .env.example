# Copy this file to `.env` and fill in real values.
# `.env` is ignored by git, this example file is not, so only use placeholders here.

# Neon PostgreSQL connection strings (Neon dashboard -> Connect).
# DATABASE_URL is the pooled one (host name ends in -pooler), used by the website.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DATABASE?sslmode=require"
# Optional: the direct connection, used by `npm run seed` for creating tables.
# If it's missing, the seed script uses DATABASE_URL instead.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Invite codes for registration. Share them only with the right people.
GUEST_INVITE_CODE="change-me-guest-code"
HOST_INVITE_CODE="change-me-host-code"

# Optional: OpenRouter (https://openrouter.ai/keys), used by "Write it for me".
# Without these the site works, but "Write it for me" says it isn't set up.
OPENROUTER_API_KEY="sk-or-your-key-here"
# Free models only (their id ends in ":free"), so the AI never costs anything.
# Find them at https://openrouter.ai/models (filter on free). Separate several with commas:
# if the first one is busy, OpenRouter tries the next.
OPENROUTER_MODEL="google/gemma-4-31b-it:free,nvidia/nemotron-3.5-lightning:free"
