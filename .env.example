# Copy this file to `.env` and fill in real values.
# `.env` is ignored by git, this example file is not, so only use placeholders here.

# Neon PostgreSQL connection string (Neon dashboard -> Connect)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Invite codes for registration. Share them only with the right people.
GUEST_INVITE_CODE="change-me-guest-code"
HOST_INVITE_CODE="change-me-host-code"

# OpenRouter (https://openrouter.ai/keys), used by "Write it for me"
OPENROUTER_API_KEY="sk-or-your-key-here"
# Any model id from https://openrouter.ai/models, change it to compare models
OPENROUTER_MODEL="openai/gpt-4o-mini"
